// Daily statistics for GoreeCloud Rich Text Editor into the D1 database goreecloud-rich-text-editor-stats; see README.md.
// Deploy from this directory: npx wrangler@4 deploy
{
  "name": "goreecloud-rich-text-editor-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // 00:30 UTC: yesterday's analytics are complete by then.
  "triggers": { "crons": ["30 0 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "goreecloud-rich-text-editor-stats", "database_id": "CONFIGURE_OWN_DB_ID", "migrations_dir": "migrations" }
  ],
  "vars": {
    "ZONE_ID": "CONFIGURE_OWN_ZONE_ID",
    "GITHUB_REPO": "GoreeCloud/rich-text-editor",
    // Days of Cloudflare analytics one run may fill in (a missed run catches up next time).
    "MAX_DAYS": "3"
  }
  // Secrets (npx wrangler@4 secret put <NAME>): CF_API_TOKEN, an API token with
  // Zone › Analytics › Read on GoreeCloud Rich Text Editor; GITHUB_TOKEN, optional, for a higher rate limit.
}
