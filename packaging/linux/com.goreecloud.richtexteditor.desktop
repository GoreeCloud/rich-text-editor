[Desktop Entry]
Type=Application
Name=GoreeCloud Notes
Comment=Local-first Markdown and rich-text notes
Exec=goreecloud_rich_text_editor %F
Icon=com.goreecloud.richtexteditor
Terminal=false
Categories=Office;TextEditor;
MimeType=text/markdown;text/x-markdown;
StartupWMClass=com.goreecloud.richtexteditor
